{
  "name": "killersudoku",
  "version": "0.3.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "vite preview --port 8084 --host 0.0.0.0 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run typecheck && npm run lint && npm run lint:levels",
    "test:smoke": "node scripts/probe.mjs",
    "lint:levels": "jest src/utils/levelValidator.test.ts",
    "lint": "node scripts/check-standards.mjs",
    "test:flows": "node scripts/flows.mjs"
  },
  "dependencies": {
    "@chakra-ui/icons": "2.2.4",
    "@chakra-ui/react": "2.8.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "framer-motion": "13.1.0",
    "localforage": "1.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "0.1.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "22.15.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "playwright": "1.62.1",
    "ts-jest": "29.4.12",
    "typescript": "5.5.4",
    "vite": "8.2.1",
    "vite-plugin-pwa": "1.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "moduleNameMapper": {
      "\\.(css|less|sass|scss)$": "<rootDir>/__mocks__/styleMock.js",
      "\\.(gif|ttf|eot|svg)$": "<rootDir>/__mocks__/fileMock.js"
    },
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
